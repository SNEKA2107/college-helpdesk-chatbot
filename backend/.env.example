# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusassist?retryWrites=true&w=majority

# JWT Secret (use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server Port
PORT=5000

# Frontend URL (for CORS). REQUIRED when the frontend is hosted separately from
# this API — every call is then cross-origin, and CORS rejects any origin not
# listed here. This is the usual cause of "Cannot connect to server" after a
# split deploy. No trailing slash.
#   single-origin (this process serves the UI): http://localhost:5000
#   split hosting  (frontend on Vercel):        https://your-frontend.vercel.app
FRONTEND_URL=http://127.0.0.1:5500

# Additional allowed origins, comma-separated (e.g. a custom domain).
# EXTRA_ORIGINS=https://campusassist.example.edu

# Set to 1 to also allow Vercel preview deployments (*.vercel.app) to call this
# API. Preview builds get a fresh hostname each time, so no static list covers
# them. Leave unset in production.
# ALLOW_VERCEL_PREVIEWS=1

# Node Environment
NODE_ENV=development

# Max login attempts per 15-min window per IP (optional — defaults to 20)
AUTH_RATE_LIMIT=20

# Max requests per minute per IP across all /api routes (optional — defaults to 150).
# Raise only for load testing, where every virtual user shares one source IP.
# GLOBAL_RATE_LIMIT=150

# Set to 1 to skip building the frontend during `npm install` (API-only deploys).
# Skipped automatically on Vercel.
# SKIP_FRONTEND_BUILD=1

# Set automatically by Render to the service's own URL — do NOT set manually.
# RENDER_EXTERNAL_URL=

# Claude AI (get key from console.anthropic.com — optional, falls back to keyword bot if not set)
ANTHROPIC_API_KEY=sk-ant-...

# Email Notifications (optional — uses Gmail by default)
# For Gmail: enable 2FA and generate an App Password at myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_app_password_here
