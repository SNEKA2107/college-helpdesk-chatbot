{
  "name": "campusassist-backend",
  "version": "1.0.0",
  "description": "CampusAssist College Helpdesk Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:local": "node dev-local.js",
    "seed": "node seed.js",
    "test": "node --test tests/critical.test.js tests/timetable-cohort.test.js tests/faculty-phase4.test.js tests/dynamic-data.test.js",
    "migrate:attendance": "node migrations/0001-dedupe-attendance.js",
