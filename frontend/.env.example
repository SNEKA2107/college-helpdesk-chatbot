# ─── CampusAssist frontend environment ───────────────────────────────────────
# Vite only exposes variables prefixed with VITE_ to the browser, and it inlines
# them at BUILD time — changing this in the hosting dashboard requires a
# redeploy, not just a restart.

# Absolute base URL of the backend API, including the /api suffix and with no
# trailing slash.
#
# REQUIRED whenever the frontend is deployed separately from the backend.
# Without it, src/services/api.js falls back to the relative path '/api', which
# resolves against the frontend's own host — where no API exists. That is what
# produces "Cannot connect to server. Make sure the backend is running."
#
#   split hosting:  VITE_API_URL=https://your-backend.vercel.app/api
#   local dev:      leave unset — the app auto-detects http://localhost:5000/api
VITE_API_URL=https://your-backend.vercel.app/api
